{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sidebar-preskok-demo",
  "registryDependencies": [
    "https://ui-three-mu.vercel.app/r/sidebar.json",
    "https://ui-three-mu.vercel.app/r/button.json",
    "https://ui-three-mu.vercel.app/r/disclosure.json",
    "https://ui-three-mu.vercel.app/r/link.json",
    "https://ui-three-mu.vercel.app/r/separator.json",
    "https://ui-three-mu.vercel.app/r/sheet.json",
    "https://ui-three-mu.vercel.app/r/tooltip.json"
  ],
  "files": [
    {
      "path": "registry/preskok/examples/sidebar-preskok-demo.tsx",
      "content": "import { Heading } from \"@/components/ui/preskok-ui/heading\"\nimport {\n  SidebarInset,\n  SidebarProvider,\n} from \"@/components/ui/preskok-ui/sidebar\"\n\nimport AppSidebar from \"./sidebar/app-sidebar\"\nimport AppSidebarNav from \"./sidebar/app-sidebar-nav\"\n\nexport default function SidebarPreskokDemo() {\n  return (\n    <SidebarProvider className=\"overflow-auto\">\n      <AppSidebar collapsible=\"dock\" />\n      <SidebarInset className=\"bg-muted/30\">\n        <AppSidebarNav />\n        <section className=\"flex flex-1 flex-col gap-4 p-4 lg:gap-6 lg:p-6\">\n          <div className=\"flex flex-wrap items-center justify-between gap-3\">\n            <div className=\"space-y-1\">\n              <Heading>Operations Overview</Heading>\n              <p className=\"text-muted-foreground text-sm\">\n                Keep fulfillment, payments, and support in sync.\n              </p>\n            </div>\n            <span className=\"text-muted-foreground bg-background rounded-md border px-2.5 py-1 text-xs font-medium\">\n              Updated 2 minutes ago\n            </span>\n          </div>\n\n          <div className=\"grid gap-4 md:grid-cols-3\">\n            <div className=\"bg-background space-y-2 rounded-xl border p-4\">\n              <p className=\"text-muted-foreground text-xs\">Orders Today</p>\n              <p className=\"text-2xl font-semibold\">148</p>\n              <p className=\"text-muted-foreground text-xs\">+12% vs yesterday</p>\n            </div>\n            <div className=\"bg-background space-y-2 rounded-xl border p-4\">\n              <p className=\"text-muted-foreground text-xs\">Pending Tickets</p>\n              <p className=\"text-2xl font-semibold\">9</p>\n              <p className=\"text-muted-foreground text-xs\">\n                3 need priority response\n              </p>\n            </div>\n            <div className=\"bg-background space-y-2 rounded-xl border p-4\">\n              <p className=\"text-muted-foreground text-xs\">Failed Payments</p>\n              <p className=\"text-2xl font-semibold\">4</p>\n              <p className=\"text-muted-foreground text-xs\">\n                All from one billing region\n              </p>\n            </div>\n          </div>\n\n          <div className=\"grid gap-4 xl:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]\">\n            <div className=\"bg-background rounded-xl border p-4 lg:p-5\">\n              <Heading level={3}>Recent Activity</Heading>\n              <div className=\"mt-4 space-y-3\">\n                <div className=\"flex items-start justify-between gap-3 border-b pb-3\">\n                  <div>\n                    <p className=\"text-sm font-medium\">Order #3921 packed</p>\n                    <p className=\"text-muted-foreground text-xs\">Warehouse A</p>\n                  </div>\n                  <span className=\"text-muted-foreground text-xs\">2m ago</span>\n                </div>\n                <div className=\"flex items-start justify-between gap-3 border-b pb-3\">\n                  <div>\n                    <p className=\"text-sm font-medium\">Ticket #188 escalated</p>\n                    <p className=\"text-muted-foreground text-xs\">\n                      Shipping delay complaint\n                    </p>\n                  </div>\n                  <span className=\"text-muted-foreground text-xs\">11m ago</span>\n                </div>\n                <div className=\"flex items-start justify-between gap-3\">\n                  <div>\n                    <p className=\"text-sm font-medium\">\n                      Payout batch processed\n                    </p>\n                    <p className=\"text-muted-foreground text-xs\">\n                      $12,420 settled\n                    </p>\n                  </div>\n                  <span className=\"text-muted-foreground text-xs\">43m ago</span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"bg-background rounded-xl border p-4 lg:p-5\">\n              <Heading level={3}>Team Focus</Heading>\n              <ul className=\"text-muted-foreground mt-4 space-y-3 text-sm\">\n                <li className=\"border-b pb-2\">Review failed payment retries</li>\n                <li className=\"border-b pb-2\">\n                  Confirm tomorrow stock transfer\n                </li>\n                <li>Prepare weekly support report</li>\n              </ul>\n            </div>\n          </div>\n        </section>\n      </SidebarInset>\n    </SidebarProvider>\n  )\n}\n",
      "type": "registry:example"
    },
    {
      "path": "registry/preskok/examples/sidebar/app-sidebar.tsx",
      "content": "\"use client\"\n\nimport {\n  ArchiveIcon,\n  ArrowDownIcon,\n  ArrowUpIcon,\n  BuildingIcon,\n  ChevronsUpDownIcon,\n  CircleCheckIcon,\n  CircleHelpIcon,\n  ClockIcon,\n  CreditCardIcon,\n  FileTextIcon,\n  HashIcon,\n  HeadphonesIcon,\n  LayoutDashboardIcon,\n  ListIcon,\n  LogOutIcon,\n  MessageSquareIcon,\n  MoreHorizontalIcon,\n  PackageIcon,\n  PlusIcon,\n  SettingsIcon,\n  ShieldIcon,\n  ShoppingBagIcon,\n  TicketIcon,\n} from \"lucide-react\"\n\nimport { Avatar } from \"@/components/ui/preskok-ui/avatar\"\nimport { Link } from \"@/components/ui/preskok-ui/link\"\nimport {\n  Menu,\n  MenuContent,\n  MenuHeader,\n  MenuItem,\n  MenuSection,\n  MenuSeparator,\n  MenuTrigger,\n} from \"@/components/ui/preskok-ui/menu\"\nimport { PreskokIcon } from \"@/components/ui/preskok-ui/preskok-icon\"\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarDisclosure,\n  SidebarDisclosureGroup,\n  SidebarDisclosurePanel,\n  SidebarDisclosureTrigger,\n  SidebarFooter,\n  SidebarHeader,\n  SidebarItem,\n  SidebarLabel,\n  SidebarLink,\n  SidebarMenuTrigger,\n  SidebarRail,\n  SidebarSection,\n  SidebarSectionGroup,\n} from \"@/components/ui/preskok-ui/sidebar\"\n\nexport default function AppSidebar(\n  props: React.ComponentProps<typeof Sidebar>\n) {\n  return (\n    <Sidebar {...props}>\n      <SidebarHeader>\n        <Link\n          className=\"flex items-center gap-x-2 group-data-[collapsible=dock]:size-10 group-data-[collapsible=dock]:justify-center\"\n          href=\"/navigation/sidebar\"\n        >\n          <PreskokIcon className=\"size-6\" />\n          <SidebarLabel className=\"font-medium\">\n            Preskok <span className=\"text-muted-foreground\">UI</span>\n          </SidebarLabel>\n        </Link>\n      </SidebarHeader>\n      <SidebarContent>\n        <SidebarSectionGroup>\n          <SidebarSection label=\"Overview\">\n            <SidebarItem tooltip=\"Overview\" isCurrent href=\"#\">\n              <LayoutDashboardIcon data-slot=\"icon\" />\n              <SidebarLabel>Overview</SidebarLabel>\n            </SidebarItem>\n\n            <SidebarItem tooltip=\"Orders\">\n              {({ isCollapsed, isFocused }) => (\n                <>\n                  <SidebarLink href=\"#\">\n                    <ShoppingBagIcon data-slot=\"icon\" />\n                    <SidebarLabel>Orders</SidebarLabel>\n                  </SidebarLink>\n                  {(!isCollapsed || isFocused) && (\n                    <Menu>\n                      <SidebarMenuTrigger aria-label=\"Manage\">\n                        <MoreHorizontalIcon data-slot=\"icon\" />\n                      </SidebarMenuTrigger>\n                      <MenuContent\n                        popover={{ offset: 0, placement: \"right top\" }}\n                      >\n                        <MenuItem href=\"#new-order\">\n                          <PlusIcon data-slot=\"icon\" />\n                          Create New Order\n                        </MenuItem>\n                        <MenuItem href=\"#view-all\">\n                          <ListIcon data-slot=\"icon\" />\n                          View All Orders\n                        </MenuItem>\n                        <MenuItem href=\"#pending-orders\">\n                          <ClockIcon data-slot=\"icon\" />\n                          Pending Orders\n                        </MenuItem>\n                        <MenuItem href=\"#completed-orders\">\n                          <CircleCheckIcon data-slot=\"icon\" />\n                          Completed Orders\n                        </MenuItem>\n                        <MenuItem href=\"#export-orders\">\n                          <ArrowUpIcon data-slot=\"icon\" />\n                          Export Orders\n                        </MenuItem>\n                      </MenuContent>\n                    </Menu>\n                  )}\n                </>\n              )}\n            </SidebarItem>\n            <SidebarItem tooltip=\"Products\">\n              {({ isCollapsed, isFocused }) => (\n                <>\n                  <SidebarLink href=\"#\">\n                    <SidebarLabel>Products</SidebarLabel>\n                  </SidebarLink>\n                  {(!isCollapsed || isFocused) && (\n                    <Menu>\n                      <SidebarMenuTrigger aria-label=\"Manage\">\n                        <MoreHorizontalIcon data-slot=\"icon\" />\n                      </SidebarMenuTrigger>\n                      <MenuContent\n                        popover={{ offset: 0, placement: \"right top\" }}\n                      >\n                        <MenuItem href=\"#new-product\">\n                          <PlusIcon data-slot=\"icon\" />\n                          Add New Product\n                        </MenuItem>\n                        <MenuItem href=\"#archive\">\n                          <ArchiveIcon data-slot=\"icon\" />\n                          Archive Product\n                        </MenuItem>\n                        <MenuItem href=\"#manage-categories\">\n                          <HashIcon data-slot=\"icon\" />\n                          Manage Categories\n                        </MenuItem>\n                        <MenuItem href=\"#import\">\n                          <ArrowDownIcon data-slot=\"icon\" />\n                          Import Products\n                        </MenuItem>\n                        <MenuItem href=\"#export\">\n                          <ArrowUpIcon data-slot=\"icon\" />\n                          Export Products\n                        </MenuItem>\n                      </MenuContent>\n                    </Menu>\n                  )}\n                </>\n              )}\n            </SidebarItem>\n            <SidebarItem href=\"#\" badge=\"4 Pending\" tooltip=\"Payments\">\n              <CreditCardIcon data-slot=\"icon\" />\n              <SidebarLabel>Payments</SidebarLabel>\n            </SidebarItem>\n          </SidebarSection>\n\n          <SidebarDisclosureGroup defaultExpandedKeys={[1]}>\n            <SidebarDisclosure id={1}>\n              <SidebarDisclosureTrigger>\n                <MoreHorizontalIcon data-slot=\"icon\" />\n                <SidebarLabel>Support</SidebarLabel>\n              </SidebarDisclosureTrigger>\n\n              <SidebarDisclosurePanel>\n                <SidebarItem href=\"#\" tooltip=\"Tickets\">\n                  <TicketIcon data-slot=\"icon\" />\n                  <SidebarLabel>Tickets</SidebarLabel>\n                </SidebarItem>\n                <SidebarItem href=\"#\" tooltip=\"Chat Support\">\n                  <MessageSquareIcon data-slot=\"icon\" />\n                  <SidebarLabel>Chat Support</SidebarLabel>\n                </SidebarItem>\n                <SidebarItem href=\"#\" tooltip=\"FAQ\">\n                  <CircleHelpIcon data-slot=\"icon\" />\n                  <SidebarLabel>FAQ</SidebarLabel>\n                </SidebarItem>\n                <SidebarItem href=\"#\" tooltip=\"Sales Docs\">\n                  <FileTextIcon data-slot=\"icon\" />\n                  <SidebarLabel>Sales Docs</SidebarLabel>\n                </SidebarItem>\n              </SidebarDisclosurePanel>\n            </SidebarDisclosure>\n            <SidebarDisclosure id={2}>\n              <SidebarDisclosureTrigger>\n                <PackageIcon data-slot=\"icon\" />\n                <SidebarLabel>Inventory</SidebarLabel>\n              </SidebarDisclosureTrigger>\n              <SidebarDisclosurePanel>\n                <SidebarItem href=\"#\" tooltip=\"Warehouse\">\n                  <BuildingIcon data-slot=\"icon\" />\n                  <SidebarLabel>Warehouse</SidebarLabel>\n                </SidebarItem>\n                <SidebarItem href=\"#\" tooltip=\"Stock Levels\">\n                  <SidebarLabel>Stock Levels</SidebarLabel>\n                </SidebarItem>\n                <SidebarItem href=\"#\" tooltip=\"Delivery\">\n                  <SidebarLabel>Delivery</SidebarLabel>\n                </SidebarItem>\n              </SidebarDisclosurePanel>\n            </SidebarDisclosure>\n          </SidebarDisclosureGroup>\n        </SidebarSectionGroup>\n      </SidebarContent>\n\n      <SidebarFooter>\n        <Menu>\n          <MenuTrigger aria-label=\"Profile\">\n            <Avatar\n              className=\"size-8 *:size-8\"\n              isSquare\n              src=\"https://intentui.com/images/avatar/cobain.jpg\"\n            />\n            <div className=\"min-w-0 text-sm\">\n              <SidebarLabel className=\"truncate\">Kurt Cobain</SidebarLabel>\n              <span className=\"text-muted-foreground -mt-0.5 block truncate\">\n                kurt@cobain.com\n              </span>\n            </div>\n            <ChevronsUpDownIcon data-slot=\"chevron\" />\n          </MenuTrigger>\n          <MenuContent\n            className=\"min-w-(--trigger-width) in-data-[state=collapsed]:min-w-56\"\n            placement=\"bottom right\"\n          >\n            <MenuSection>\n              <MenuHeader separator>\n                <span className=\"block\">Kurt Cobain</span>\n                <span className=\"text-muted-foreground font-normal\">\n                  @cobain\n                </span>\n              </MenuHeader>\n            </MenuSection>\n\n            <MenuItem href=\"#dashboard\">\n              <LayoutDashboardIcon data-slot=\"icon\" />\n              Dashboard\n            </MenuItem>\n            <MenuItem href=\"#settings\">\n              <SettingsIcon data-slot=\"icon\" />\n              Settings\n            </MenuItem>\n            <MenuItem href=\"#security\">\n              <ShieldIcon data-slot=\"icon\" />\n              Security\n            </MenuItem>\n            <MenuSeparator />\n\n            <MenuItem href=\"#contact\">\n              <HeadphonesIcon data-slot=\"icon\" />\n              Customer Support\n            </MenuItem>\n            <MenuSeparator />\n            <MenuItem href=\"#logout\">\n              <LogOutIcon data-slot=\"icon\" />\n              Log out\n            </MenuItem>\n          </MenuContent>\n        </Menu>\n      </SidebarFooter>\n      <SidebarRail />\n    </Sidebar>\n  )\n}\n",
      "type": "registry:component"
    },
    {
      "path": "registry/preskok/examples/sidebar/app-sidebar-nav.tsx",
      "content": "\"use client\"\n\nimport {\n  Command,\n  LayoutDashboardIcon,\n  LogOutIcon,\n  SettingsIcon,\n} from \"lucide-react\"\n\nimport { Avatar } from \"@/components/ui/preskok-ui/avatar\"\nimport {\n  Breadcrumbs,\n  BreadcrumbsItem,\n} from \"@/components/ui/preskok-ui/breadcrumbs\"\nimport {\n  Menu,\n  MenuContent,\n  MenuHeader,\n  MenuItem,\n  MenuLabel,\n  MenuSection,\n  MenuSeparator,\n  MenuTrigger,\n} from \"@/components/ui/preskok-ui/menu\"\nimport {\n  SidebarNav,\n  SidebarTrigger,\n} from \"@/components/ui/preskok-ui/sidebar\"\n\nexport default function AppSidebarNav() {\n  return (\n    <SidebarNav>\n      <span className=\"flex items-center gap-x-4\">\n        <SidebarTrigger className=\"-ml-2\" />\n        <Breadcrumbs className=\"hidden md:flex\">\n          <BreadcrumbsItem href=\"/navigation/sidebar\">\n            Dashboard\n          </BreadcrumbsItem>\n          <BreadcrumbsItem>Newsletter</BreadcrumbsItem>\n        </Breadcrumbs>\n      </span>\n      <UserMenu />\n    </SidebarNav>\n  )\n}\n\nfunction UserMenu() {\n  return (\n    <Menu>\n      <MenuTrigger className=\"ml-auto md:hidden\" aria-label=\"Open Menu\">\n        <Avatar\n          isSquare\n          alt=\"kurt cobain\"\n          src=\"https://intentui.com/images/avatar/cobain.jpg\"\n        />\n      </MenuTrigger>\n      <MenuContent popover={{ placement: \"bottom end\" }} className=\"min-w-64\">\n        <MenuSection>\n          <MenuHeader separator>\n            <span className=\"block\">Kurt Cobain</span>\n            <span className=\"text-muted-foreground font-normal\">@cobain</span>\n          </MenuHeader>\n        </MenuSection>\n        <MenuItem href=\"#dashboard\">\n          <LayoutDashboardIcon data-slot=\"icon\" />\n          <MenuLabel>Dashboard</MenuLabel>\n        </MenuItem>\n        <MenuItem href=\"#settings\">\n          <SettingsIcon data-slot=\"icon\" />\n          <MenuLabel>Settings</MenuLabel>\n        </MenuItem>\n        <MenuSeparator />\n        <MenuItem>\n          <Command data-slot=\"icon\" />\n          <MenuLabel>Command Menu</MenuLabel>\n        </MenuItem>\n        <MenuSeparator />\n        <MenuItem href=\"#contact-s\">\n          <MenuLabel>Contact Support</MenuLabel>\n        </MenuItem>\n        <MenuSeparator />\n        <MenuItem href=\"#logout\">\n          <LogOutIcon data-slot=\"icon\" />\n          <MenuLabel>Log out</MenuLabel>\n        </MenuItem>\n      </MenuContent>\n    </Menu>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "meta": {
    "iframeHeight": "640px",
    "container": "w-full bg-surface overflow-hidden min-h-[640px] flex items-stretch justify-stretch p-0 min-w-0",
    "mobile": "component"
  },
  "type": "registry:example"
}