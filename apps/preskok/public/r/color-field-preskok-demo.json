{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "color-field-preskok-demo",
  "registryDependencies": [
    "https://ui-three-mu.vercel.app/r/color-field.json",
    "https://ui-three-mu.vercel.app/r/color-picker.json",
    "https://ui-three-mu.vercel.app/r/field.json",
    "https://ui-three-mu.vercel.app/r/loader.json"
  ],
  "files": [
    {
      "path": "registry/preskok/examples/color-field-preskok-demo.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\nimport { parseColor, type Color } from \"react-stately/Color\"\n\nimport { ColorField } from \"@/components/ui/preskok-ui/color-field\"\nimport { Label } from \"@/components/ui/preskok-ui/field\"\nimport { Input } from \"@/components/ui/preskok-ui/input\"\n\nexport default function ColorFieldPreskokDemo() {\n  const [color, setColor] = useState(parseColor(\"#1d4ed8\"))\n\n  function handleColorChange(value: Color | null) {\n    if (value) {\n      setColor(value)\n    }\n  }\n\n  return (\n    <div className=\"grid gap-4\">\n      <ColorField value={color} onChange={handleColorChange}>\n        <Label>Hex</Label>\n        <Input placeholder=\"#000000\" />\n      </ColorField>\n      <div className=\"grid gap-3 sm:grid-cols-3\">\n        <ColorField\n          value={color}\n          onChange={handleColorChange}\n          colorSpace=\"hsl\"\n          channel=\"hue\"\n        >\n          <Label>Hue</Label>\n          <Input />\n        </ColorField>\n        <ColorField\n          value={color}\n          onChange={handleColorChange}\n          colorSpace=\"hsl\"\n          channel=\"saturation\"\n        >\n          <Label>Saturation</Label>\n          <Input />\n        </ColorField>\n        <ColorField\n          value={color}\n          onChange={handleColorChange}\n          colorSpace=\"hsl\"\n          channel=\"lightness\"\n        >\n          <Label>Lightness</Label>\n          <Input />\n        </ColorField>\n      </div>\n      <p className=\"text-muted-foreground text-sm\">\n        Current value: {color.toString(\"hex\")}\n      </p>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}