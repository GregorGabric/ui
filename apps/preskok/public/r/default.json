      "--danger-foreground": "oklch(0.971 0.013 17.38)",
      "--destructive": "oklch(0.577 0.245 27.325)",
      "--destructive-foreground": "oklch(0.971 0.013 17.38)",
      "--card": "oklch(1 0 0)",
      "--card-foreground": "oklch(0.141 0.005 285.823)",
      "--popover": "oklch(1 0 0)",
      "--popover-foreground": "oklch(0.141 0.005 285.823)",
      "--border": "oklch(0.909 0.005 56.366)",
      "--input": "oklch(0.869 0.005 56.366)",
      "--ring": "oklch(0.546 0.245 262.881)",
      "--navbar": "oklch(0.995 0.001 106.423)",
      "--navbar-foreground": "oklch(0.147 0.004 49.25)",
      "--sidebar": "oklch(0.97 0.001 106.424)",
      "--sidebar-foreground": "oklch(0.147 0.004 49.25)",
      "--sidebar-primary": "oklch(0.92 0.004 56)",
      "--sidebar-primary-foreground": "oklch(0.147 0.004 49.25)",
      "--sidebar-accent": "oklch(0.92 0.004 56)",
      "--sidebar-accent-foreground": "oklch(0.147 0.004 49.25)",
      "--sidebar-border": "oklch(0.911 0.005 56.366)",
      "--sidebar-ring": "oklch(0.65 0.01 56)",
      "--radius-lg": "0.5rem",
      "--radius": "var(--radius-lg)",
      "--radius-xs": "calc(var(--radius-lg) * 0.5)",
      "--radius-sm": "calc(var(--radius-lg) * 0.75)",
