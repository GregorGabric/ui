      "--primary-foreground": "oklch(1 0 0)",
      "--secondary": "oklch(0.238 0.007 34.298)",
      "--secondary-foreground": "oklch(0.985 0.001 106.423)",
      "--accent": "oklch(0.546 0.245 262.881)",
      "--accent-foreground": "oklch(1 0 0)",
      "--muted": "oklch(0.216 0.006 56.043)",
      "--muted-foreground": "oklch(0.709 0.01 56.259)",
      "--overlay": "oklch(0.186 0.006 56.043)",
      "--overlay-foreground": "oklch(0.985 0.001 106.423)",
      "--success": "oklch(0.596 0.145 163.225)",
      "--success-foreground": "oklch(1 0 0)",
      "--warning": "oklch(0.828 0.189 84.429)",
      "--warning-foreground": "oklch(0.279 0.077 45.635)",
      "--danger": "oklch(0.577 0.245 27.325)",
      "--danger-foreground": "oklch(0.971 0.013 17.38)",
      "--destructive": "oklch(0.577 0.245 27.325)",
      "--destructive-foreground": "oklch(0.971 0.013 17.38)",
      "--card": "oklch(0.191 0.005 285.823)",
      "--card-foreground": "oklch(0.985 0 0)",
      "--popover": "oklch(0.21 0.006 285.885)",
      "--popover-foreground": "oklch(0.985 0 0)",
      "--border": "oklch(0.274 0.01 67.558)",
      "--input": "oklch(0.324 0.01 67.558)",
      "--navbar": "oklch(0.196 0.006 56.043)",
      "--navbar-foreground": "oklch(0.985 0.001 106.423)",
      "--sidebar": "oklch(0.166 0.006 56.043)",
      "--sidebar-foreground": "oklch(0.985 0.001 106.423)",
      "--sidebar-primary": "oklch(0.238 0.007 56)",
      "--sidebar-primary-foreground": "oklch(0.985 0.001 106.423)",
      "--sidebar-accent": "oklch(0.238 0.007 56)",
      "--sidebar-accent-foreground": "oklch(0.985 0.001 106.423)",
      "--sidebar-border": "oklch(0.274 0.01 67.558)",
      "--sidebar-ring": "oklch(0.55 0.01 56)",
      "--chart-1": "oklch(0.488 0.243 264.376)",
      "--chart-2": "oklch(0.623 0.214 259.815)",
      "--chart-3": "oklch(0.707 0.165 254.624)",
      "--chart-4": "oklch(0.809 0.105 251.813)",
      "--chart-5": "oklch(0.882 0.059 254.128)",
      "--code": "var(--surface)",
      "--code-foreground": "var(--surface-foreground)",
      "--code-highlight": "oklch(0.27 0 0)",
      "--code-number": "oklch(0.72 0 0)",
      "--selection": "oklch(0.922 0 0)",
      "--selection-foreground": "oklch(0.205 0 0)",
      "--surface": "oklch(0.2 0 0)",
      "--surface-foreground": "oklch(0.708 0 0)"
    },
    "@layer base": {
      "*, ::after, ::before, ::backdrop, ::file-selector-button": {
        "border-color": "var(--border, currentColor)"
      },
      "*": {
        "font-feature-settings": "\"cv11\", \"ss01\"",
        "text-rendering": "optimizeLegibility",
        "scrollbar-width": "thin",
        "scrollbar-color": "var(--border) transparent"
      },
      "html": {
        "font-feature-settings": "\"cv02\", \"cv03\", \"cv04\", \"cv11\"",
        "font-variation-settings": "normal",
        "height": "100%",
        "-webkit-font-smoothing": "antialiased",
        "-moz-osx-font-smoothing": "grayscale",
        "-webkit-tap-highlight-color": "transparent"
      },
      "body": {
        "background-color": "var(--background)",
        "color": "var(--foreground)",
        "font-synthesis-weight": "none"
      },
      "::selection": {
        "background-color": "var(--selection)",
        "color": "var(--selection-foreground)"
      },
      "a:active, button:active": {
        "@apply opacity-60 md:opacity-100": {}
      },
      "::-webkit-scrollbar": {
        "width": "4px"
      },
      "::-webkit-scrollbar-track": {
        "background": "transparent"
      },
      "::-webkit-scrollbar-thumb": {
        "background": "var(--border)",
        "border-radius": "4px"
      }
    }
  },
  "type": "registry:base",
  "config": {
    "style": "preskok",
    "tailwind": {
      "baseColor": "neutral",
      "cssVariables": true
    },
    "iconLibrary": "lucide",
    "registries": {
      "@preskok": "https://ui-three-mu.vercel.app/r/{name}.json"
    }
  }
}