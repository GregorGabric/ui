{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "drawer-snap-points-demo",
  "registryDependencies": [
    "https://ui-three-mu.vercel.app/r/drawer.json",
    "https://ui-three-mu.vercel.app/r/button.json"
  ],
  "files": [
    {
      "path": "registry/preskok/examples/drawer-snap-points-demo.tsx",
      "content": "\"use client\"\n\nimport { buttonStyles } from \"@/components/ui/preskok-ui/button\"\nimport { Drawer } from \"@/components/ui/preskok-ui/drawer\"\n\nconst specs = [\n  [\"Mileage\", \"42,180 km\"],\n  [\"Fuel\", \"Diesel\"],\n  [\"Gearbox\", \"Automatic\"],\n  [\"Power\", \"140 kW\"],\n  [\"First registration\", \"03/2022\"],\n  [\"Location\", \"Ljubljana\"],\n]\n\nexport default function DrawerSnapPointsDemo() {\n  return (\n    <Drawer>\n      <Drawer.Trigger className={buttonStyles({ intent: \"outline\" })}>\n        View vehicle\n      </Drawer.Trigger>\n      <Drawer.Content snapPoints={[240]}>\n        <Drawer.Header>\n          <Drawer.Title>Škoda Octavia Combi</Drawer.Title>\n          <Drawer.Description>\n            Drag up for the full spec sheet, or swipe down to dismiss.\n          </Drawer.Description>\n        </Drawer.Header>\n        <Drawer.Body>\n          <dl className=\"divide-y text-sm\">\n            {specs.map(([term, value]) => (\n              <div key={term} className=\"flex justify-between py-3\">\n                <dt className=\"text-muted-foreground\">{term}</dt>\n                <dd className=\"font-medium tabular-nums\">{value}</dd>\n              </div>\n            ))}\n          </dl>\n        </Drawer.Body>\n        <Drawer.Footer>\n          <Drawer.Close intent=\"primary\" className=\"w-full\">\n            Place a bid\n          </Drawer.Close>\n        </Drawer.Footer>\n      </Drawer.Content>\n    </Drawer>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}