      "content": "\"use client\"\n\nimport { LifeBuoyIcon, SendIcon } from \"lucide-react\"\n\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarProvider,\n  SidebarSection,\n  SidebarSectionGroup,\n} from \"@/components/ui/preskok-ui/sidebar\"\n\nexport default function AppSidebar() {\n  return (\n    <SidebarProvider>\n      <Sidebar>\n        <SidebarContent>\n          <SidebarSectionGroup>\n            <SidebarSection>\n              <div className=\"flex items-center gap-2 rounded-md p-2\">\n                <LifeBuoyIcon />\n                Support\n              </div>\n              <div className=\"flex items-center gap-2 rounded-md p-2\">\n                <SendIcon />\n                Feedback\n              </div>\n            </SidebarSection>\n          </SidebarSectionGroup>\n        </SidebarContent>\n      </Sidebar>\n    </SidebarProvider>\n  )\n}\n",
      "type": "registry:component"
    }
