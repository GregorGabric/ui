{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "toggle-demo",
  "registryDependencies": [
    "https://ui-three-mu.vercel.app/r/toggle.json"
  ],
  "files": [
    {
      "path": "registry/preskok/examples/toggle-demo.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\nimport { BoldIcon, ItalicIcon, UnderlineIcon } from \"lucide-react\"\n\nimport { Toggle } from \"@/components/ui/preskok-ui/toggle\"\n\nexport default function ToggleDemo() {\n  const [isBold, setIsBold] = useState(true)\n\n  return (\n    <div className=\"flex flex-wrap items-center gap-2\">\n      <Toggle aria-label=\"Toggle bold\" isSelected={isBold} onChange={setIsBold}>\n        <BoldIcon className=\"h-4 w-4\" />\n      </Toggle>\n      <Toggle defaultSelected aria-label=\"Toggle italic\">\n        <ItalicIcon className=\"h-4 w-4\" />\n      </Toggle>\n      <Toggle aria-label=\"Toggle underline\">\n        <UnderlineIcon className=\"h-4 w-4\" />\n      </Toggle>\n      <Toggle isDisabled aria-label=\"Toggle disabled\">\n        <UnderlineIcon className=\"h-4 w-4\" />\n      </Toggle>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}