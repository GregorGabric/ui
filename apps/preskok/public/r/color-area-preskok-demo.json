  "files": [
    {
      "path": "registry/preskok/examples/color-area-preskok-demo.tsx",
      "content": "\"use client\"\n\nimport { ColorArea } from \"@/components/ui/preskok-ui/color-area\"\nimport { ColorField } from \"@/components/ui/preskok-ui/color-field\"\nimport { ColorSlider } from \"@/components/ui/preskok-ui/color-slider\"\nimport { Input } from \"@/components/ui/preskok-ui/input\"\n\nexport default function ColorAreaPreskokDemo() {\n  return (\n    <div className=\"flex flex-col gap-3\">\n      <ColorArea\n        defaultValue=\"hsb(0, 100%, 50%)\"\n        colorSpace=\"hsb\"\n        xChannel=\"saturation\"\n        yChannel=\"brightness\"\n      />\n      <ColorSlider\n        defaultValue=\"hsb(0, 100%, 50%)\"\n        colorSpace=\"hsb\"\n        channel=\"hue\"\n      />\n      <ColorField defaultValue=\"hsb(0, 100%, 50%)\" aria-label=\"Hex\">\n        <Input placeholder=\"#000000\" />\n      </ColorField>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}