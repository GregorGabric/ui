      "path": "registry/preskok/examples/link-button-preskok-demo.tsx",
      "content": "\"use client\"\n\nimport { buttonStyles } from \"@/components/ui/preskok-ui/button\"\nimport { Link } from \"@/components/ui/preskok-ui/link\"\n\nexport default function LinkButtonPreskokDemo() {\n  return (\n    <div className=\"flex gap-2\">\n      <Link className={buttonStyles()} href=\"#use-as-button\">\n        Link\n      </Link>\n      <Link\n        className={buttonStyles({ intent: \"outline\" })}\n        href=\"#use-as-button\"\n      >\n        Link\n      </Link>\n      <Link\n        className={buttonStyles({ intent: \"plain\", isCircle: true })}\n        href=\"#use-as-button\"\n      >\n        Link\n      </Link>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}