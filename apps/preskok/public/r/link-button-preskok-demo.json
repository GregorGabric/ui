{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "link-button-preskok-demo",
  "registryDependencies": [
    "https://ui-three-mu.vercel.app/r/link.json",
    "https://ui-three-mu.vercel.app/r/button.json"
  ],
  "files": [
    {
      "path": "registry/preskok/examples/link-button-preskok-demo.tsx",
      "content": "\"use client\"\n\nimport { ArrowRightIcon, DownloadIcon, ExternalLinkIcon } from \"lucide-react\"\n\nimport { buttonStyles } from \"@/components/ui/preskok-ui/button\"\nimport { Link } from \"@/components/ui/preskok-ui/link\"\n\nexport default function LinkButtonPreskokDemo() {\n  return (\n    <div className=\"flex flex-wrap gap-2\">\n      <Link className={buttonStyles()} href=\"#use-as-button\">\n        Get started\n        <ArrowRightIcon />\n      </Link>\n      <Link\n        className={buttonStyles({ intent: \"outline\" })}\n        href=\"#use-as-button\"\n      >\n        <DownloadIcon />\n        Download\n      </Link>\n      <Link\n        className={buttonStyles({\n          intent: \"plain\",\n          size: \"sq-md\",\n          isCircle: true,\n        })}\n        href=\"#use-as-button\"\n        aria-label=\"Open in new tab\"\n      >\n        <ExternalLinkIcon />\n      </Link>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}