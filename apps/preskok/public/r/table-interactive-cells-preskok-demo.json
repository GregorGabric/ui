{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "table-interactive-cells-preskok-demo",
  "registryDependencies": [
    "https://ui-three-mu.vercel.app/r/input.json",
    "https://ui-three-mu.vercel.app/r/table.json",
    "https://ui-three-mu.vercel.app/r/text-field.json"
  ],
  "files": [
    {
      "path": "registry/preskok/examples/table-interactive-cells-preskok-demo.tsx",
      "content": "\"use client\"\n\nimport { Input } from \"@/components/ui/preskok-ui/input\"\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableColumn,\n  TableHeader,\n  TableRow,\n} from \"@/components/ui/preskok-ui/table\"\nimport { TextField } from \"@/components/ui/preskok-ui/text-field\"\n\nconst vehicles = [\n  { id: 1, vehicle: \"Volvo EX30\", stock: \"VE-204\", note: \"Demo vehicle\" },\n  { id: 2, vehicle: \"BMW i4\", stock: \"BM-118\", note: \"Priority lead\" },\n  { id: 3, vehicle: \"Audi Q4 e-tron\", stock: \"AU-512\", note: \"\" },\n]\n\nexport default function TableInteractiveCellsPreskokDemo() {\n  return (\n    <div className=\"bg-background w-full max-w-3xl overflow-hidden rounded-xl border p-4 shadow-sm\">\n      <Table\n        aria-label=\"Vehicle notes\"\n        keyboardNavigationBehavior=\"tab\"\n        selectionMode=\"multiple\"\n      >\n        <TableHeader>\n          <TableColumn isRowHeader>Vehicle</TableColumn>\n          <TableColumn>Stock</TableColumn>\n          <TableColumn>Internal note</TableColumn>\n        </TableHeader>\n        <TableBody items={vehicles}>\n          {(vehicle) => (\n            <TableRow id={vehicle.id}>\n              <TableCell className=\"text-foreground font-medium\">\n                {vehicle.vehicle}\n              </TableCell>\n              <TableCell>{vehicle.stock}</TableCell>\n              <TableCell>\n                <TextField\n                  aria-label={`${vehicle.vehicle} internal note`}\n                  defaultValue={vehicle.note}\n                >\n                  <Input className=\"min-w-48\" placeholder=\"Add a note\" />\n                </TextField>\n              </TableCell>\n            </TableRow>\n          )}\n        </TableBody>\n      </Table>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}