  "files": [
    {
      "path": "registry/preskok/examples/meter-preskok-demo.tsx",
      "content": "\"use client\"\n\nimport { Description, Label } from \"@/components/ui/preskok-ui/field\"\nimport {\n  Meter,\n  MeterHeader,\n  MeterTrack,\n  MeterValue,\n} from \"@/components/ui/preskok-ui/meter\"\n\nexport function Component() {\n  return (\n    <div className=\"grid w-full max-w-md gap-5\">\n      <Meter value={41}>\n        <MeterHeader>\n          <Label>Storage space</Label>\n          <MeterValue />\n        </MeterHeader>\n        <Description>Healthy usage renders with the success color.</Description>\n        <MeterTrack />\n      </Meter>\n      <Meter value={78}>\n        <MeterHeader>\n          <Label>CPU load</Label>\n          <MeterValue />\n        </MeterHeader>\n        <Description>Warning range as load approaches capacity.</Description>\n        <MeterTrack />\n      </Meter>\n      <Meter value={92}>\n        <MeterHeader>\n          <Label>Error budget</Label>\n          <MeterValue />\n        </MeterHeader>\n        <Description>High usage switches to the danger color.</Description>\n        <MeterTrack />\n      </Meter>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}