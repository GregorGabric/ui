{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "input-group-demo",
  "registryDependencies": [
    "https://ui-three-mu.vercel.app/r/input.json"
  ],
  "files": [
    {
      "path": "registry/preskok/example/input-group-demo.tsx",
      "content": "\"use client\"\n\nimport { MailIcon, SearchIcon } from \"lucide-react\"\n\nimport {\n  InputGroup,\n  InputGroupAddon,\n  InputGroupButton,\n  InputGroupInput,\n  InputGroupText,\n} from \"@/components/ui/preskok-ui/input\"\n\nconst buttonIntents = [\n  [\"Primary action\", \"Publish\", \"primary\"],\n  [\"Secondary action\", \"Sync\", \"secondary\"],\n  [\"Warning action\", \"Retry\", \"warning\"],\n  [\"Danger action\", \"Delete\", \"danger\"],\n  [\"Outline action\", \"Export\", \"outline\"],\n  [\"Plain action\", \"Clear\", \"plain\"],\n] as const\n\nexport default function InputGroupDemo() {\n  return (\n    <div className=\"w-full max-w-2xl space-y-8\">\n      <InputGroup>\n        <InputGroupAddon>\n          <MailIcon />\n        </InputGroupAddon>\n        <InputGroupInput type=\"email\" placeholder=\"you@example.com\" />\n      </InputGroup>\n\n      <InputGroup>\n        <InputGroupAddon>\n          <InputGroupText>https://</InputGroupText>\n        </InputGroupAddon>\n        <InputGroupInput placeholder=\"preskok\" />\n        <InputGroupAddon align=\"inline-end\">\n          <InputGroupText>.com</InputGroupText>\n        </InputGroupAddon>\n      </InputGroup>\n\n      <div className=\"space-y-3\">\n        <h3 className=\"text-sm font-medium\">Button intents</h3>\n        {buttonIntents.map(([placeholder, label, intent]) => (\n          <InputGroup key={intent}>\n            <InputGroupInput placeholder={placeholder} />\n            <InputGroupAddon align=\"inline-end\">\n              <InputGroupButton intent={intent} size=\"sm\">\n                {label}\n              </InputGroupButton>\n            </InputGroupAddon>\n          </InputGroup>\n        ))}\n      </div>\n\n      <InputGroup>\n        <InputGroupInput placeholder=\"Customer, order, or route\" />\n        <InputGroupAddon align=\"inline-end\">\n          <InputGroupButton intent=\"primary\" size=\"icon-sm\" aria-label=\"Search\">\n            <SearchIcon />\n          </InputGroupButton>\n        </InputGroupAddon>\n      </InputGroup>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}