{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "login-02",
  "type": "registry:block",
  "description": "A two column login page with a cover image.",
  "registryDependencies": [
    "button",
    "card",
    "input",
    "label"
  ],
  "files": [
    {
      "path": "registry/preskok/blocks/login-02/page.tsx",
      "content": "import { LoginForm } from \"@/registry/preskok/blocks/login-02/components/login-form\"\nimport { PreskokIcon } from \"@/registry/preskok/ui/preskok-ui/preskok-icon\"\n\nexport default function LoginPage() {\n  return (\n    <div className=\"grid min-h-svh lg:grid-cols-2\">\n      <div className=\"flex flex-col gap-4 p-6 md:p-10\">\n        <div className=\"flex justify-center gap-2 md:justify-start\">\n          <a href=\"#\" className=\"flex items-center gap-2 font-medium\">\n            <div className=\"text-primary flex size-6 items-center justify-center rounded-md\">\n              <PreskokIcon className=\"size-4\" />\n            </div>\n            Preskok d.o.o.\n          </a>\n        </div>\n        <div className=\"flex flex-1 items-center justify-center\">\n          <div className=\"w-full max-w-xs\">\n            <LoginForm />\n          </div>\n        </div>\n      </div>\n      <div className=\"bg-muted relative hidden lg:block\">\n        <img\n          src=\"/placeholder.svg\"\n          alt=\"Image\"\n          className=\"absolute inset-0 h-full w-full object-cover dark:brightness-[0.2] dark:grayscale\"\n        />\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:page",
      "target": "app/login/page.tsx"
    },
    {
      "path": "registry/preskok/blocks/login-02/components/login-form.tsx",
      "content": "import { cn } from \"@/registry/preskok/lib/utils\"\nimport { Button } from \"@/registry/preskok/ui/preskok-ui/button\"\nimport { PreskokAuthButton } from \"@/registry/preskok/ui/preskok-ui/preskok-auth-button\"\nimport { TextField } from \"@/registry/preskok/ui/preskok-ui/text-field\"\n\nexport function LoginForm({\n  className,\n  ...props\n}: React.ComponentProps<\"form\">) {\n  return (\n    <form className={cn(\"flex flex-col gap-6\", className)} {...props}>\n      <div className=\"flex flex-col items-center gap-2 text-center\">\n        <h1 className=\"text-2xl font-bold\">Login to your account</h1>\n        <p className=\"text-muted-foreground text-sm text-balance\">\n          Enter your email below to login to your account\n        </p>\n      </div>\n      <div className=\"grid gap-6\">\n        <div className=\"grid gap-3\">\n          <TextField label=\"Email\" aria-label=\"Email\" type=\"email\" isRequired />\n        </div>\n        <div className=\"grid gap-3\">\n          <div className=\"flex items-center\">\n            <span className=\"text-sm font-medium\">Password</span>\n            <a\n              href=\"#\"\n              className=\"ml-auto text-sm underline-offset-4 hover:underline\"\n            >\n              Forgot your password?\n            </a>\n          </div>\n          <TextField\n            aria-label=\"Password\"\n            type=\"password\"\n            isRevealable\n            isRequired\n          />\n        </div>\n        <Button type=\"submit\" className=\"w-full\">\n          Login\n        </Button>\n        <div className=\"after:border-border relative text-center text-sm after:absolute after:inset-0 after:top-1/2 after:z-0 after:flex after:items-center after:border-t\">\n          <span className=\"bg-background text-muted-foreground relative z-10 px-2\">\n            Or continue with\n          </span>\n        </div>\n        <PreskokAuthButton type=\"button\" className=\"w-full\" />\n      </div>\n      <div className=\"text-center text-sm\">\n        Don&apos;t have an account?{\" \"}\n        <a href=\"#\" className=\"underline underline-offset-4\">\n          Sign up\n        </a>\n      </div>\n    </form>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "categories": [
    "authentication",
    "login"
  ]
}