{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sidebar-01",
  "type": "registry:block",
  "description": "A simple sidebar with navigation grouped by section.",
  "registryDependencies": [
    "sidebar",
    "breadcrumb",
    "separator",
    "label",
    "dropdown-menu"
  ],
  "files": [
    {
      "path": "registry/preskok/blocks/sidebar-01/page.tsx",
      "content": "import { AppSidebar } from \"@/registry/preskok/blocks/sidebar-01/components/app-sidebar\"\nimport {\n  Breadcrumb,\n  BreadcrumbItem,\n  BreadcrumbLink,\n  BreadcrumbList,\n  BreadcrumbPage,\n  BreadcrumbSeparator,\n} from \"@/registry/preskok/ui/breadcrumb\"\nimport {\n  SidebarInset,\n  SidebarProvider,\n  SidebarTrigger,\n} from \"@/registry/preskok/ui/preskok-ui/sidebar\"\nimport { Separator } from \"@/registry/preskok/ui/separator\"\n\nexport default function Page() {\n  return (\n    <SidebarProvider>\n      <AppSidebar />\n      <SidebarInset>\n        <header className=\"flex h-16 shrink-0 items-center gap-2 border-b px-4\">\n          <SidebarTrigger className=\"-ml-1\" />\n          <Separator\n            orientation=\"vertical\"\n            className=\"mr-2 data-[orientation=vertical]:h-4\"\n          />\n          <Breadcrumb>\n            <BreadcrumbList>\n              <BreadcrumbItem className=\"hidden md:block\">\n                <BreadcrumbLink href=\"#\">\n                  Building Your Application\n                </BreadcrumbLink>\n              </BreadcrumbItem>\n              <BreadcrumbSeparator className=\"hidden md:block\" />\n              <BreadcrumbItem>\n                <BreadcrumbPage>Data Fetching</BreadcrumbPage>\n              </BreadcrumbItem>\n            </BreadcrumbList>\n          </Breadcrumb>\n        </header>\n        <div className=\"flex flex-1 flex-col gap-4 p-4\">\n          <div className=\"grid auto-rows-min gap-4 md:grid-cols-3\">\n            <div className=\"bg-muted/50 aspect-video rounded-xl\" />\n            <div className=\"bg-muted/50 aspect-video rounded-xl\" />\n            <div className=\"bg-muted/50 aspect-video rounded-xl\" />\n          </div>\n          <div className=\"bg-muted/50 min-h-[100vh] flex-1 rounded-xl md:min-h-min\" />\n        </div>\n      </SidebarInset>\n    </SidebarProvider>\n  )\n}\n",
      "type": "registry:page",
      "target": "app/dashboard/page.tsx"
    },
    {
      "path": "registry/preskok/blocks/sidebar-01/components/app-sidebar.tsx",
      "content": "\"use client\"\n\nimport {\n  Archive,\n  Box,\n  Building,\n  CheckCircle,\n  ChevronsUpDown,\n  Clock,\n  CreditCard,\n  Download,\n  FileText,\n  Hash,\n  HelpCircle,\n  Home,\n  LifeBuoy,\n  List,\n  LogOut,\n  MessageSquare,\n  MoreHorizontal,\n  Plus,\n  Settings,\n  ShieldCheck,\n  ShoppingBag,\n  Ticket,\n  Upload,\n} from \"lucide-react\"\n\nimport { Avatar } from \"@/registry/preskok/ui/preskok-ui/avatar\"\nimport { Link } from \"@/registry/preskok/ui/preskok-ui/link\"\nimport {\n  Menu,\n  MenuContent,\n  MenuHeader,\n  MenuItem,\n  MenuSection,\n  MenuSeparator,\n  MenuTrigger,\n} from \"@/registry/preskok/ui/preskok-ui/menu\"\nimport { PreskokIcon } from \"@/registry/preskok/ui/preskok-ui/preskok-icon\"\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarDisclosure,\n  SidebarDisclosureGroup,\n  SidebarDisclosurePanel,\n  SidebarDisclosureTrigger,\n  SidebarFooter,\n  SidebarHeader,\n  SidebarItem,\n  SidebarLabel,\n  SidebarLink,\n  SidebarMenuTrigger,\n  SidebarRail,\n  SidebarSection,\n  SidebarSectionGroup,\n} from \"@/registry/preskok/ui/preskok-ui/sidebar\"\n\nexport default function AppSidebar(\n  props: React.ComponentProps<typeof Sidebar>\n) {\n  return (\n    <Sidebar {...props}>\n      <SidebarHeader>\n        <Link\n          href=\"/docs/components/layouts/sidebar\"\n          className=\"flex items-center gap-x-2\"\n        >\n          <PreskokIcon className=\"size-6\" />\n          <SidebarLabel className=\"font-medium\">\n            Intent <span className=\"text-muted-fg\">UI</span>\n          </SidebarLabel>\n        </Link>\n      </SidebarHeader>\n      <SidebarContent>\n        <SidebarSectionGroup>\n          <SidebarSection label=\"Overview\">\n            <SidebarItem tooltip=\"Overview\" isCurrent href=\"#\">\n              <Home data-slot=\"icon\" />\n              <SidebarLabel>Overview</SidebarLabel>\n            </SidebarItem>\n            <SidebarItem tooltip=\"Orders\">\n              {({ isCollapsed, isFocused }) => (\n                <>\n                  <SidebarLink href=\"#\">\n                    <ShoppingBag data-slot=\"icon\" />\n                    <SidebarLabel>Orders</SidebarLabel>\n                  </SidebarLink>\n                  {(!isCollapsed || isFocused) && (\n                    <Menu>\n                      <SidebarMenuTrigger aria-label=\"Manage\">\n                        <MoreHorizontal data-slot=\"icon\" />\n                      </SidebarMenuTrigger>\n                      <MenuContent\n                        popover={{\n                          offset: 0,\n                          placement: \"right top\",\n                        }}\n                      >\n                        <MenuItem href=\"#new-order\">\n                          <Plus data-slot=\"icon\" />\n                          Create New Order\n                        </MenuItem>\n                        <MenuItem href=\"#view-all\">\n                          <List data-slot=\"icon\" />\n                          View All Orders\n                        </MenuItem>\n                        <MenuItem href=\"#pending-orders\">\n                          <Clock data-slot=\"icon\" />\n                          Pending Orders\n                        </MenuItem>\n                        <MenuItem href=\"#completed-orders\">\n                          <CheckCircle data-slot=\"icon\" />\n                          Completed Orders\n                        </MenuItem>\n                        <MenuItem href=\"#export-orders\">\n                          <Upload data-slot=\"icon\" />\n                          Export Orders\n                        </MenuItem>\n                      </MenuContent>\n                    </Menu>\n                  )}\n                </>\n              )}\n            </SidebarItem>\n            <SidebarItem tooltip=\"Products\">\n              {({ isCollapsed, isFocused }) => (\n                <>\n                  <SidebarLink href=\"#\">\n                    <Box data-slot=\"icon\" />\n                    <SidebarLabel>Products</SidebarLabel>\n                  </SidebarLink>\n                  {(!isCollapsed || isFocused) && (\n                    <Menu>\n                      <SidebarMenuTrigger aria-label=\"Manage\">\n                        <MoreHorizontal data-slot=\"icon\" />\n                      </SidebarMenuTrigger>\n                      <MenuContent\n                        popover={{\n                          offset: 0,\n                          placement: \"right top\",\n                        }}\n                      >\n                        <MenuItem href=\"#new-product\">\n                          <Plus data-slot=\"icon\" />\n                          Add New Product\n                        </MenuItem>\n                        <MenuItem href=\"#archive\">\n                          <Archive data-slot=\"icon\" />\n                          Archive Product\n                        </MenuItem>\n                        <MenuItem href=\"#manage-categories\">\n                          <Hash data-slot=\"icon\" />\n                          Manage Categories\n                        </MenuItem>\n                        <MenuItem href=\"#import\">\n                          <Download data-slot=\"icon\" />\n                          Import Products\n                        </MenuItem>\n                        <MenuItem href=\"#export\">\n                          <Upload data-slot=\"icon\" />\n                          Export Products\n                        </MenuItem>\n                      </MenuContent>\n                    </Menu>\n                  )}\n                </>\n              )}\n            </SidebarItem>\n            <SidebarItem href=\"#\" badge=\"4 Pending\" tooltip=\"Payments\">\n              <CreditCard data-slot=\"icon\" />\n              <SidebarLabel>Payments</SidebarLabel>\n            </SidebarItem>\n          </SidebarSection>\n\n          <SidebarDisclosureGroup defaultExpandedKeys={[1]}>\n            <SidebarDisclosure id={1}>\n              <SidebarDisclosureTrigger>\n                <MoreHorizontal data-slot=\"icon\" />\n                <SidebarLabel>Support</SidebarLabel>\n              </SidebarDisclosureTrigger>\n              <SidebarDisclosurePanel>\n                <SidebarItem href=\"#\" tooltip=\"Tickets\">\n                  <Ticket data-slot=\"icon\" />\n                  <SidebarLabel>Tickets</SidebarLabel>\n                </SidebarItem>\n                <SidebarItem href=\"#\" tooltip=\"Chat Support\">\n                  <MessageSquare data-slot=\"icon\" />\n                  <SidebarLabel>Chat Support</SidebarLabel>\n                </SidebarItem>\n                <SidebarItem href=\"#\" tooltip=\"FAQ\">\n                  <HelpCircle data-slot=\"icon\" />\n                  <SidebarLabel>FAQ</SidebarLabel>\n                </SidebarItem>\n                <SidebarItem href=\"#\" tooltip=\"Documentation\">\n                  <FileText data-slot=\"icon\" />\n                  <SidebarLabel>Documentation</SidebarLabel>\n                </SidebarItem>\n              </SidebarDisclosurePanel>\n            </SidebarDisclosure>\n\n            <SidebarDisclosure id={2}>\n              <SidebarDisclosureTrigger>\n                <Archive data-slot=\"icon\" />\n                <SidebarLabel>Inventory</SidebarLabel>\n              </SidebarDisclosureTrigger>\n              <SidebarDisclosurePanel>\n                <SidebarItem href=\"#\" tooltip=\"Warehouse\">\n                  <Building data-slot=\"icon\" />\n                  <SidebarLabel>Warehouse</SidebarLabel>\n                </SidebarItem>\n                <SidebarItem href=\"#\" tooltip=\"Stock Levels\">\n                  <SidebarLabel>Stock Levels</SidebarLabel>\n                </SidebarItem>\n                <SidebarItem href=\"#\" tooltip=\"Shipping\">\n                  <SidebarLabel>Shipping</SidebarLabel>\n                </SidebarItem>\n              </SidebarDisclosurePanel>\n            </SidebarDisclosure>\n          </SidebarDisclosureGroup>\n        </SidebarSectionGroup>\n      </SidebarContent>\n      <SidebarFooter className=\"flex flex-row justify-between gap-4 group-data-[state=collapsed]:flex-col\">\n        <Menu>\n          <MenuTrigger\n            className=\"flex w-full items-center justify-between\"\n            aria-label=\"Profile\"\n          >\n            <div className=\"flex items-center gap-x-2\">\n              <Avatar\n                className=\"size-8 *:size-8 group-data-[state=collapsed]:size-6 group-data-[state=collapsed]:*:size-6\"\n                isSquare\n                src=\"https://intentui.com/images/avatar/cobain.jpg\"\n              />\n              <div className=\"text-sm in-data-[collapsible=dock]:hidden\">\n                <SidebarLabel>Kurt Cobain</SidebarLabel>\n                <span className=\"text-muted-fg -mt-0.5 block\">\n                  kurt@domain.com\n                </span>\n              </div>\n            </div>\n            <ChevronsUpDown data-slot=\"chevron\" />\n          </MenuTrigger>\n          <MenuContent\n            className=\"min-w-(--trigger-width) in-data-[sidebar-collapsible=collapsed]:min-w-56\"\n            placement=\"bottom right\"\n          >\n            <MenuSection>\n              <MenuHeader separator>\n                <span className=\"block\">Kurt Cobain</span>\n                <span className=\"text-muted-fg font-normal\">@cobain</span>\n              </MenuHeader>\n            </MenuSection>\n            <MenuItem href=\"#dashboard\">\n              <Home data-slot=\"icon\" />\n              Dashboard\n            </MenuItem>\n            <MenuItem href=\"#settings\">\n              <Settings data-slot=\"icon\" />\n              Settings\n            </MenuItem>\n            <MenuItem href=\"#security\">\n              <ShieldCheck data-slot=\"icon\" />\n              Security\n            </MenuItem>\n            <MenuSeparator />\n            <MenuItem href=\"#contact\">\n              <LifeBuoy data-slot=\"icon\" />\n              Customer Support\n            </MenuItem>\n            <MenuSeparator />\n            <MenuItem href=\"#logout\">\n              <LogOut data-slot=\"icon\" />\n              Log out\n            </MenuItem>\n          </MenuContent>\n        </Menu>\n      </SidebarFooter>\n      <SidebarRail />\n    </Sidebar>\n  )\n}\n",
      "type": "registry:component"
    },
    {
      "path": "registry/preskok/blocks/sidebar-01/components/search-form.tsx",
      "content": "import { SearchField } from \"@/registry/preskok/ui/preskok-ui/search-field\"\n\nexport function SearchForm({ ...props }: React.ComponentProps<\"form\">) {\n  return (\n    <form {...props}>\n      <SearchField id=\"search\" placeholder=\"Search the docs...\" />\n    </form>\n  )\n}\n",
      "type": "registry:component"
    },
    {
      "path": "registry/preskok/blocks/sidebar-01/components/version-switcher.tsx",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { Check, ChevronsUpDown, GalleryVerticalEnd } from \"lucide-react\"\n\nimport {\n  Menu,\n  MenuContent,\n  MenuItem,\n  MenuTrigger,\n} from \"@/registry/preskok/ui/preskok-ui/menu\"\n\nexport function VersionSwitcher({\n  versions,\n  defaultVersion,\n}: {\n  versions: Array<string>\n  defaultVersion: string\n}) {\n  const [selectedVersion, setSelectedVersion] = React.useState(defaultVersion)\n\n  return (\n    <Menu>\n      <MenuTrigger className=\"hover:bg-sidebar-accent hover:text-sidebar-accent-foreground flex w-full items-center gap-2 rounded-lg p-2 text-left\">\n        <div className=\"bg-sidebar-primary text-sidebar-primary-foreground flex aspect-square size-8 items-center justify-center rounded-lg\">\n          <GalleryVerticalEnd className=\"size-4\" />\n        </div>\n        <div className=\"flex flex-col gap-0.5 text-sm leading-none\">\n          <span className=\"font-medium\">Documentation</span>\n          <span>v{selectedVersion}</span>\n        </div>\n        <ChevronsUpDown className=\"ml-auto\" />\n      </MenuTrigger>\n      <MenuContent>\n        {versions.map((version) => (\n          <MenuItem\n            key={version}\n            onAction={() => {\n              setSelectedVersion(version)\n            }}\n          >\n            v{version}{\" \"}\n            {version === selectedVersion && <Check className=\"ml-auto\" />}\n          </MenuItem>\n        ))}\n      </MenuContent>\n    </Menu>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "categories": [
    "sidebar",
    "dashboard"
  ]
}