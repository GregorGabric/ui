      "path": "registry/preskok/examples/preskok-auth-button-preskok-demo.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\n\nimport { PreskokAuthButton } from \"@/components/ui/preskok-ui/preskok-auth-button\"\n\nexport default function PreskokAuthButtonPreskokDemo() {\n  const [status, setStatus] = useState(\"Ready\")\n\n  return (\n    <div className=\"grid gap-4\">\n      <div className=\"flex flex-wrap items-center gap-3\">\n        <PreskokAuthButton />\n        <PreskokAuthButton intent=\"primary\" />\n        <PreskokAuthButton intent=\"secondary\" />\n        <PreskokAuthButton label=\"Sign in with Preskok\" />\n        <PreskokAuthButton\n          label=\"Connect workspace\"\n          onPress={() => setStatus(\"Redirecting to Preskok...\")}\n        />\n      </div>\n      <p className=\"text-muted-foreground text-sm\">{status}</p>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}