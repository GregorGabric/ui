{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sidebar-header",
  "files": [
    {
      "path": "registry/preskok/internal/sidebar-header.tsx",
      "content": "\"use client\"\n\nimport { ChevronDownIcon } from \"lucide-react\"\n\nimport {\n  Menu,\n  MenuContent,\n  MenuItem,\n  MenuTrigger,\n} from \"@/components/ui/preskok-ui/menu\"\nimport {\n  Sidebar,\n  SidebarHeader,\n  SidebarInset,\n  SidebarProvider,\n  SidebarTrigger,\n} from \"@/components/ui/preskok-ui/sidebar\"\n\nexport default function AppSidebar() {\n  return (\n    <SidebarProvider>\n      <Sidebar>\n        <SidebarHeader>\n          <Menu>\n            <MenuTrigger className=\"hover:bg-sidebar-accent hover:text-sidebar-accent-foreground group-open/menu:bg-sidebar-accent group-open/menu:text-sidebar-accent-foreground flex w-full items-center gap-2 rounded-lg p-2 text-left text-sm font-medium\">\n              Select Workspace\n              <ChevronDownIcon className=\"ml-auto\" />\n            </MenuTrigger>\n            <MenuContent className=\"min-w-(--trigger-width)\">\n              <MenuItem id=\"acme-inc\">\n                <span>Acme Inc</span>\n              </MenuItem>\n              <MenuItem id=\"acme-corp\">\n                <span>Acme Corp.</span>\n              </MenuItem>\n            </MenuContent>\n          </Menu>\n        </SidebarHeader>\n      </Sidebar>\n      <SidebarInset>\n        <header className=\"flex h-12 items-center justify-between px-4\">\n          <SidebarTrigger />\n        </header>\n      </SidebarInset>\n    </SidebarProvider>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:internal"
}