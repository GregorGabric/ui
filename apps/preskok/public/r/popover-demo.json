{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "popover-demo",
  "registryDependencies": [
    "https://ui-three-mu.vercel.app/r/popover.json",
    "https://ui-three-mu.vercel.app/r/button.json"
  ],
  "files": [
    {
      "path": "registry/preskok/examples/popover-demo.tsx",
      "content": "\"use client\"\n\nimport { useState } from \"react\"\n\nimport { Button } from \"@/components/ui/preskok-ui/button\"\nimport {\n  Popover,\n  PopoverBody,\n  PopoverClose,\n  PopoverContent,\n  PopoverDescription,\n  PopoverFooter,\n  PopoverHeader,\n  PopoverTitle,\n} from \"@/components/ui/preskok-ui/popover\"\n\nexport default function PopoverDemo() {\n  const [isOpen, setIsOpen] = useState(false)\n\n  return (\n    <div className=\"flex flex-wrap items-center gap-4\">\n      <Popover>\n        <Button intent=\"outline\">Deployment summary</Button>\n        <PopoverContent arrow placement=\"bottom start\">\n          <PopoverHeader>\n            <PopoverTitle>Production deploy</PopoverTitle>\n            <PopoverDescription>\n              Build completed in 2m 14s and promoted after smoke checks.\n            </PopoverDescription>\n          </PopoverHeader>\n          <PopoverBody>\n            <dl className=\"grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm\">\n              <dt className=\"text-muted-foreground\">Commit</dt>\n              <dd>8f24c91</dd>\n              <dt className=\"text-muted-foreground\">Region</dt>\n              <dd>iad1</dd>\n              <dt className=\"text-muted-foreground\">Runtime</dt>\n              <dd>Node.js 24</dd>\n            </dl>\n          </PopoverBody>\n        </PopoverContent>\n      </Popover>\n\n      <Popover isOpen={isOpen} onOpenChange={setIsOpen}>\n        <Button intent=\"plain\">Retention policy</Button>\n        <PopoverContent placement=\"top\" className=\"max-w-sm\">\n          <PopoverHeader>\n            <PopoverTitle>Keep logs for 30 days?</PopoverTitle>\n            <PopoverDescription>\n              Shorter retention lowers storage cost but limits incident review.\n            </PopoverDescription>\n          </PopoverHeader>\n          <PopoverFooter>\n            <PopoverClose intent=\"outline\">Cancel</PopoverClose>\n            <Button intent=\"primary\" onPress={() => setIsOpen(false)}>\n              Apply\n            </Button>\n          </PopoverFooter>\n        </PopoverContent>\n      </Popover>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}