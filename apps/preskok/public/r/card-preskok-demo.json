      "content": "\"use client\"\n\nimport { Button } from \"@/components/ui/preskok-ui/button\"\nimport {\n  Card,\n  CardAction,\n  CardContent,\n  CardDescription,\n  CardFooter,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/preskok-ui/card\"\n\nexport default function CardPreskokDemo() {\n  return (\n    <Card className=\"w-full max-w-sm\">\n      <CardHeader>\n        <div className=\"flex items-start justify-between\">\n          <div>\n            <CardTitle>Team Listing</CardTitle>\n            <CardDescription>\n              Collaborative workspace for the team\n            </CardDescription>\n          </div>\n          <CardAction>\n            <Button size=\"sm\" intent=\"outline\">\n              Edit\n            </Button>\n          </CardAction>\n        </div>\n      </CardHeader>\n      <CardContent>\n        <div className=\"space-y-2\">\n          <div className=\"text-2xl font-bold\">12</div>\n          <p className=\"text-muted-foreground text-sm\">Active members</p>\n        </div>\n      </CardContent>\n      <CardFooter>\n        <Button className=\"w-full\">View Details</Button>\n      </CardFooter>\n    </Card>\n  )\n}\n",
