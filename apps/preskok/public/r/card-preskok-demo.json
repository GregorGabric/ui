{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "card-preskok-demo",
  "files": [
    {
      "path": "registry/preskok/examples/card-preskok-demo.tsx",
      "content": "\"use client\"\n\nimport { MoreHorizontalIcon } from \"lucide-react\"\n\nimport { Badge } from \"@/components/ui/preskok-ui/badge\"\nimport { Button } from \"@/components/ui/preskok-ui/button\"\nimport {\n  Card,\n  CardAction,\n  CardContent,\n  CardDescription,\n  CardFooter,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/preskok-ui/card\"\nimport {\n  Menu,\n  MenuContent,\n  MenuItem,\n} from \"@/components/ui/preskok-ui/menu\"\n\nexport default function CardPreskokDemo() {\n  return (\n    <div className=\"grid w-full max-w-3xl gap-4 md:grid-cols-2\">\n      <Card>\n        <CardHeader>\n          <CardTitle>Release readiness</CardTitle>\n          <CardDescription>Checkout redesign launch checklist</CardDescription>\n          <CardAction>\n            <Menu>\n              <Button size=\"sq-sm\" intent=\"plain\" aria-label=\"More actions\">\n                <MoreHorizontalIcon />\n              </Button>\n              <MenuContent placement=\"bottom end\">\n                <MenuItem>Duplicate</MenuItem>\n                <MenuItem>Archive</MenuItem>\n              </MenuContent>\n            </Menu>\n          </CardAction>\n        </CardHeader>\n        <CardContent>\n          <div className=\"grid gap-3 text-sm\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-muted-foreground\">QA pass</span>\n              <Badge intent=\"success\">Complete</Badge>\n            </div>\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-muted-foreground\">Rollout</span>\n              <Badge intent=\"warning\">20%</Badge>\n            </div>\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-muted-foreground\">Owner</span>\n              <span>Growth</span>\n            </div>\n          </div>\n        </CardContent>\n        <CardFooter className=\"gap-2\">\n          <Button intent=\"outline\">Preview</Button>\n          <Button>Ship</Button>\n        </CardFooter>\n      </Card>\n\n      <Card>\n        <CardHeader\n          title=\"Team capacity\"\n          description=\"Engineering coverage for this week\"\n        />\n        <CardContent>\n          <div className=\"space-y-2\">\n            <div className=\"text-3xl font-semibold tabular-nums\">12</div>\n            <p className=\"text-muted-foreground text-sm\">\n              Available reviewers across three squads.\n            </p>\n          </div>\n        </CardContent>\n        <CardFooter>\n          <Button className=\"w-full\" intent=\"secondary\">\n            View schedule\n          </Button>\n        </CardFooter>\n      </Card>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}