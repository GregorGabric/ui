{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "experimental-pie-chart-stacked-preskok-demo",
  "registryDependencies": [
    "https://ui-three-mu.vercel.app/r/experimental-pie-chart.json",
    "https://ui-three-mu.vercel.app/r/card.json"
  ],
  "files": [
    {
      "path": "registry/preskok/examples/experimental-pie-chart-stacked-preskok-demo.tsx",
      "content": "\"use client\"\n\nimport { TrendingUp } from \"lucide-react\"\n\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardFooter,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/preskok-ui/card\"\nimport { ExperimentalPieChart } from \"@/components/ui/preskok-ui/experimental-pie-chart\"\n\nconst chartData = [\n  { month: \"january\", desktop: 186, mobile: 80 },\n  { month: \"february\", desktop: 305, mobile: 200 },\n  { month: \"march\", desktop: 237, mobile: 120 },\n  { month: \"april\", desktop: 173, mobile: 190 },\n  { month: \"may\", desktop: 209, mobile: 130 },\n]\n\nexport default function ExperimentalPieChartStackedPreskokDemo() {\n  return (\n    <Card className=\"w-full max-w-md\">\n      <CardHeader className=\"items-center pb-0 text-center\">\n        <CardTitle>Pie Chart - Stacked</CardTitle>\n        <CardDescription>January - June 2024</CardDescription>\n      </CardHeader>\n      <CardContent>\n        <ExperimentalPieChart\n          ariaLabel=\"Pie Chart - Stacked\"\n          className=\"mx-auto\"\n          data={chartData}\n          dataKey=\"desktop\"\n          nameKey=\"month\"\n          rings={[\n            { dataKey: \"desktop\", outerRadius: 60 },\n            { dataKey: \"mobile\", innerRadius: 70, outerRadius: 90 },\n          ]}\n          size={{ height: 250 }}\n          variant=\"donut\"\n          pieProps={{ stroke: \"var(--background)\", strokeWidth: 2 }}\n          legend={false}\n          config={{\n            january: { label: \"January\", color: \"var(--chart-1)\" },\n            february: { label: \"February\", color: \"var(--chart-2)\" },\n            march: { label: \"March\", color: \"var(--chart-3)\" },\n            april: { label: \"April\", color: \"var(--chart-4)\" },\n            may: { label: \"May\", color: \"var(--chart-5)\" },\n          }}\n        />\n      </CardContent>\n      <CardFooter className=\"flex-col items-center gap-2 text-sm\">\n        <div className=\"flex items-center gap-2 leading-none font-medium\">\n          Trending up by 5.2% this month\n          <TrendingUp aria-hidden className=\"size-4\" />\n        </div>\n        <div className=\"leading-none text-muted-foreground\">\n          Showing total visitors for the last 6 months\n        </div>\n      </CardFooter>\n    </Card>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}