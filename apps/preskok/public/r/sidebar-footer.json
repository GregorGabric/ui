{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sidebar-footer",
  "files": [
    {
      "path": "registry/preskok/internal/sidebar-footer.tsx",
      "content": "\"use client\"\n\nimport { ChevronUpIcon } from \"lucide-react\"\n\nimport {\n  Menu,\n  MenuContent,\n  MenuItem,\n  MenuTrigger,\n} from \"@/components/ui/preskok-ui/menu\"\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarFooter,\n  SidebarHeader,\n  SidebarInset,\n  SidebarProvider,\n  SidebarTrigger,\n} from \"@/components/ui/preskok-ui/sidebar\"\n\nexport default function AppSidebar() {\n  return (\n    <SidebarProvider>\n      <Sidebar>\n        <SidebarHeader />\n        <SidebarContent />\n        <SidebarFooter>\n          <Menu>\n            <MenuTrigger className=\"hover:bg-sidebar-accent hover:text-sidebar-accent-foreground group-open/menu:bg-sidebar-accent group-open/menu:text-sidebar-accent-foreground flex w-full items-center gap-2 rounded-lg p-2 text-left text-sm font-medium\">\n              Username\n              <ChevronUpIcon className=\"ml-auto\" />\n            </MenuTrigger>\n            <MenuContent placement=\"top\" className=\"min-w-(--trigger-width)\">\n              <MenuItem id=\"account\">\n                <span>Account</span>\n              </MenuItem>\n              <MenuItem id=\"billing\">\n                <span>Billing</span>\n              </MenuItem>\n              <MenuItem id=\"sign-out\">\n                <span>Sign out</span>\n              </MenuItem>\n            </MenuContent>\n          </Menu>\n        </SidebarFooter>\n      </Sidebar>\n      <SidebarInset>\n        <header className=\"flex h-12 items-center justify-between px-4\">\n          <SidebarTrigger />\n        </header>\n      </SidebarInset>\n    </SidebarProvider>\n  )\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:internal"
}