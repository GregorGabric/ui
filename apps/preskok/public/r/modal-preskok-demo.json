{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "modal-preskok-demo",
  "registryDependencies": [
    "https://ui-three-mu.vercel.app/r/modal.json",
    "https://ui-three-mu.vercel.app/r/button.json",
    "https://ui-three-mu.vercel.app/r/text-field.json"
  ],
  "files": [
    {
      "path": "registry/preskok/examples/modal-preskok-demo.tsx",
      "content": "\"use client\"\n\nimport { Button } from \"@/components/ui/preskok-ui/button\"\nimport { Input } from \"@/components/ui/preskok-ui/input\"\nimport {\n  Modal,\n  ModalBody,\n  ModalClose,\n  ModalContent,\n  ModalDescription,\n  ModalFooter,\n  ModalHeader,\n  ModalTitle,\n} from \"@/components/ui/preskok-ui/modal\"\nimport { TextField } from \"@/components/ui/preskok-ui/text-field\"\n\nexport function ModalPreskokDemo() {\n  return (\n    <div className=\"flex flex-wrap items-center gap-3\">\n      <Modal>\n        <Button intent=\"outline\">Rename</Button>\n        <ModalContent size=\"md\">\n          {({ close }) => (\n            <>\n              <ModalHeader>\n                <ModalTitle>Rename project</ModalTitle>\n                <ModalDescription>\n                  Change how this project will appear across the dashboard.\n                </ModalDescription>\n              </ModalHeader>\n              <ModalBody>\n                <TextField aria-label=\"Name\">\n                  <Input placeholder=\"Enter a name\" />\n                </TextField>\n              </ModalBody>\n              <ModalFooter>\n                <ModalClose>Cancel</ModalClose>\n                <Button onPress={close} intent=\"primary\">\n                  Save changes\n                </Button>\n              </ModalFooter>\n            </>\n          )}\n        </ModalContent>\n      </Modal>\n\n      <Modal>\n        <Button intent=\"danger\">Delete workspace</Button>\n        <ModalContent role=\"alertdialog\" size=\"sm\" isBlurred>\n          {({ close }) => (\n            <>\n              <ModalHeader>\n                <ModalTitle>Delete workspace?</ModalTitle>\n                <ModalDescription>\n                  Active members, API keys, and billing exports will be removed.\n                </ModalDescription>\n              </ModalHeader>\n              <ModalFooter>\n                <ModalClose intent=\"outline\">Cancel</ModalClose>\n                <Button intent=\"danger\" onPress={close}>\n                  Delete workspace\n                </Button>\n              </ModalFooter>\n            </>\n          )}\n        </ModalContent>\n      </Modal>\n\n      <Modal>\n        <Button intent=\"plain\">Preview report</Button>\n        <ModalContent size=\"2xl\">\n          <ModalHeader\n            title=\"Quarterly report\"\n            description=\"Review metrics before sharing them with leadership.\"\n          />\n          <ModalBody>\n            <div className=\"grid gap-3 sm:grid-cols-3\">\n              {[\"Pipeline\", \"Revenue\", \"Retention\"].map((metric) => (\n                <div key={metric} className=\"rounded-lg border p-3\">\n                  <div className=\"text-sm font-medium\">{metric}</div>\n                  <div className=\"mt-1 text-sm text-muted-foreground\">\n                    Ready for review\n                  </div>\n                </div>\n              ))}\n            </div>\n          </ModalBody>\n          <ModalFooter>\n            <ModalClose>Close</ModalClose>\n          </ModalFooter>\n        </ModalContent>\n      </Modal>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}