{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "time-field-preskok-demo",
  "registryDependencies": [
    "https://ui-three-mu.vercel.app/r/time-field.json",
    "https://ui-three-mu.vercel.app/r/field.json"
  ],
  "files": [
    {
      "path": "registry/preskok/examples/time-field-preskok-demo.tsx",
      "content": "\"use client\"\n\nimport { Time } from \"@internationalized/date\"\n\nimport { DateInput } from \"@/components/ui/preskok-ui/date-field\"\nimport { Description, Label } from \"@/components/ui/preskok-ui/field\"\nimport { TimeField } from \"@/components/ui/preskok-ui/time-field\"\n\nexport default function TimeFieldPreskokDemo() {\n  return (\n    <div className=\"bg-background grid w-full max-w-xl gap-4 rounded-xl border p-5 shadow-sm sm:grid-cols-2\">\n      <TimeField\n        defaultValue={new Time(9, 30)}\n        minValue={new Time(8, 0)}\n        hourCycle={12}\n      >\n        <Label>Pickup window</Label>\n        <Description>Earliest available slot.</Description>\n        <DateInput className=\"min-w-36\" />\n      </TimeField>\n      <TimeField defaultValue={new Time(17, 0)} hourCycle={24}>\n        <Label>Dispatch cutoff</Label>\n        <Description>Operations uses 24-hour time.</Description>\n        <DateInput className=\"min-w-36\" />\n      </TimeField>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}