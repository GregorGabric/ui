{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "sheet-stacking-demo",
  "registryDependencies": [
    "https://ui-three-mu.vercel.app/r/sheet.json",
    "https://ui-three-mu.vercel.app/r/button.json",
    "https://ui-three-mu.vercel.app/r/radio.json",
    "https://ui-three-mu.vercel.app/r/text-field.json",
    "https://ui-three-mu.vercel.app/r/textarea.json"
  ],
  "files": [
    {
      "path": "registry/preskok/examples/sheet-stacking-demo.tsx",
      "content": "\"use client\"\n\nimport { Button } from \"@/components/ui/preskok-ui/button\"\nimport { Label } from \"@/components/ui/preskok-ui/field\"\nimport { Input } from \"@/components/ui/preskok-ui/input\"\nimport { Radio, RadioGroup } from \"@/components/ui/preskok-ui/radio\"\nimport {\n  Sheet,\n  SheetBody,\n  SheetClose,\n  SheetContent,\n  SheetDescription,\n  SheetFooter,\n  SheetHeader,\n  SheetTitle,\n} from \"@/components/ui/preskok-ui/sheet\"\nimport { TextField } from \"@/components/ui/preskok-ui/text-field\"\nimport { Textarea } from \"@/components/ui/preskok-ui/textarea\"\n\nexport default function SheetStackingDemo() {\n  return (\n    <Sheet>\n      <Button intent=\"outline\">Open lot</Button>\n      <SheetContent side=\"bottom\" isFloat={false} style={{ height: 520 }}>\n        <SheetHeader>\n          <SheetTitle>Audi A4 Avant 40 TDI</SheetTitle>\n          <SheetDescription>Lot AU-3021 · Ends in 2h 14m</SheetDescription>\n        </SheetHeader>\n        <SheetBody className=\"gap-3 text-sm\">\n          <p className=\"text-muted-foreground\">\n            Sold by Avtohiša Kranj. Inspected on 2 October with two minor\n            findings.\n          </p>\n          <Sheet>\n            <Button intent=\"outline\">Contact seller</Button>\n            <SheetContent side=\"bottom\" isFloat={false} style={{ height: 440 }}>\n              <SheetHeader>\n                <SheetTitle>Contact seller</SheetTitle>\n                <SheetDescription>\n                  Your message goes to Avtohiša Kranj.\n                </SheetDescription>\n              </SheetHeader>\n              <SheetBody className=\"gap-4\">\n                <RadioGroup defaultValue=\"question\">\n                  <Label>Topic</Label>\n                  <Radio value=\"question\">Question about the vehicle</Radio>\n                  <Radio value=\"viewing\">Arrange a viewing</Radio>\n                </RadioGroup>\n                <Sheet>\n                  <Button intent=\"plain\" className=\"self-start\">\n                    Add pickup details\n                  </Button>\n                  <SheetContent\n                    side=\"bottom\"\n                    isFloat={false}\n                    style={{ height: 360 }}\n                  >\n                    <SheetHeader>\n                      <SheetTitle>Pickup details</SheetTitle>\n                    </SheetHeader>\n                    <SheetBody className=\"gap-4\">\n                      <TextField>\n                        <Label>Pickup address</Label>\n                        <Input placeholder=\"Street, city\" />\n                      </TextField>\n                    </SheetBody>\n                    <SheetFooter>\n                      <SheetClose intent=\"primary\">Save</SheetClose>\n                    </SheetFooter>\n                  </SheetContent>\n                </Sheet>\n                <TextField>\n                  <Label>Message</Label>\n                  <Textarea placeholder=\"Is the timing belt replaced?\" />\n                </TextField>\n              </SheetBody>\n              <SheetFooter>\n                <SheetClose intent=\"primary\">Send</SheetClose>\n              </SheetFooter>\n            </SheetContent>\n          </Sheet>\n        </SheetBody>\n        <SheetFooter>\n          <SheetClose>Close</SheetClose>\n        </SheetFooter>\n      </SheetContent>\n    </Sheet>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}