{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "drawer-demo",
  "registryDependencies": [
    "https://ui-three-mu.vercel.app/r/drawer.json",
    "https://ui-three-mu.vercel.app/r/button.json",
    "https://ui-three-mu.vercel.app/r/text-field.json"
  ],
  "files": [
    {
      "path": "registry/preskok/examples/drawer-demo.tsx",
      "content": "\"use client\"\n\nimport { buttonStyles } from \"@/components/ui/preskok-ui/button\"\nimport { Drawer } from \"@/components/ui/preskok-ui/drawer\"\nimport { Label } from \"@/components/ui/preskok-ui/field\"\nimport { Input } from \"@/components/ui/preskok-ui/input\"\nimport { TextField } from \"@/components/ui/preskok-ui/text-field\"\n\nexport default function DrawerDemo() {\n  return (\n    <Drawer>\n      <Drawer.Trigger className={buttonStyles({ intent: \"outline\" })}>\n        Vehicle Inquiry\n      </Drawer.Trigger>\n      <Drawer.Content>\n        <Drawer.Header>\n          <Drawer.Title>Contact Dealer</Drawer.Title>\n          <Drawer.Description>\n            Get more information about this vehicle or schedule a test drive.\n          </Drawer.Description>\n        </Drawer.Header>\n        <Drawer.Body className=\"space-y-4\">\n          <TextField isRequired>\n            <Label>Full Name</Label>\n            <Input placeholder=\"Enter your full name\" />\n          </TextField>\n          <TextField type=\"email\" isRequired>\n            <Label>Email Address</Label>\n            <Input placeholder=\"your.email@example.com\" />\n          </TextField>\n          <TextField type=\"tel\">\n            <Label>Phone Number</Label>\n            <Input placeholder=\"+1 (555) 123-4567\" />\n          </TextField>\n          <div className=\"bg-muted rounded p-3\">\n            <h4 className=\"text-sm font-medium\">Vehicle of Interest</h4>\n            <p className=\"text-muted-foreground text-sm\">\n              2024 Toyota Camry LE - Stock #TC240156\n            </p>\n            <p className=\"text-muted-foreground text-sm\">Price: $28,400</p>\n          </div>\n        </Drawer.Body>\n        <Drawer.Footer>\n          <Drawer.Close className=\"w-full\">Send Inquiry</Drawer.Close>\n        </Drawer.Footer>\n      </Drawer.Content>\n    </Drawer>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}