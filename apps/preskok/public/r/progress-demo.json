{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "progress-demo",
  "registryDependencies": [
    "https://ui-three-mu.vercel.app/r/meter.json",
    "https://ui-three-mu.vercel.app/r/progress-bar.json"
  ],
  "files": [
    {
      "path": "registry/preskok/examples/progress-demo.tsx",
      "content": "\"use client\"\n\nimport { Label } from \"@/components/ui/preskok-ui/field\"\nimport {\n  Meter,\n  MeterHeader,\n  MeterTrack,\n  MeterValue,\n} from \"@/components/ui/preskok-ui/meter\"\nimport {\n  ProgressBar,\n  ProgressBarHeader,\n  ProgressBarTrack,\n  ProgressBarValue,\n} from \"@/components/ui/preskok-ui/progress-bar\"\n\nexport default function ProgressDemo() {\n  return (\n    <div className=\"space-y-6\">\n      <div className=\"space-y-4\">\n        <h4 className=\"font-medium\">Vehicle Assembly Progress</h4>\n        <ProgressBar value={75}>\n          <ProgressBarHeader>\n            <Label>Engine Installation</Label>\n            <ProgressBarValue />\n          </ProgressBarHeader>\n          <ProgressBarTrack />\n        </ProgressBar>\n        <ProgressBar value={45}>\n          <ProgressBarHeader>\n            <Label>Interior Assembly</Label>\n            <ProgressBarValue />\n          </ProgressBarHeader>\n          <ProgressBarTrack />\n        </ProgressBar>\n        <ProgressBar value={90}>\n          <ProgressBarHeader>\n            <Label>Quality Inspection</Label>\n            <ProgressBarValue />\n          </ProgressBarHeader>\n          <ProgressBarTrack />\n        </ProgressBar>\n      </div>\n\n      <div className=\"space-y-4\">\n        <h4 className=\"font-medium\">Performance Metrics</h4>\n        <Meter\n          value={68}\n          minValue={0}\n          maxValue={100}\n          formatOptions={{ style: \"percent\" }}\n        >\n          <MeterHeader>\n            <Label>Fuel Tank Level</Label>\n            <MeterValue />\n          </MeterHeader>\n          <MeterTrack />\n        </Meter>\n        <Meter\n          value={85}\n          minValue={0}\n          maxValue={100}\n          formatOptions={{ style: \"percent\" }}\n        >\n          <MeterHeader>\n            <Label>Battery Charge</Label>\n            <MeterValue />\n          </MeterHeader>\n          <MeterTrack />\n        </Meter>\n        <Meter value={32} minValue={0} maxValue={50}>\n          <MeterHeader>\n            <Label>Tire Pressure</Label>\n            <MeterValue />\n          </MeterHeader>\n          <MeterTrack />\n        </Meter>\n      </div>\n\n      <div className=\"space-y-4\">\n        <h4 className=\"font-medium\">Service Status</h4>\n        <ProgressBar\n          value={100}\n          className=\"[&_[data-slot=progress-bar-track]>div>div]:bg-green-100 [&_[data-slot=progress-content]]:bg-green-500\"\n        >\n          <ProgressBarHeader>\n            <Label>Oil Change Service</Label>\n            <ProgressBarValue />\n          </ProgressBarHeader>\n          <ProgressBarTrack />\n        </ProgressBar>\n        <ProgressBar\n          value={25}\n          className=\"[&_[data-slot=progress-content]]:bg-yellow-500\"\n        >\n          <ProgressBarHeader>\n            <Label>Brake Inspection</Label>\n            <ProgressBarValue />\n          </ProgressBarHeader>\n          <ProgressBarTrack />\n        </ProgressBar>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}