      "path": "registry/preskok/examples/progress-circle-preskok-demo.tsx",
      "content": "\"use client\"\n\nimport { CheckIcon } from \"lucide-react\"\n\nimport { ProgressCircle } from \"@/components/ui/preskok-ui/progress-circle\"\n\nexport default function ProgressCirclePreskokDemo() {\n  return (\n    <div className=\"flex flex-wrap items-center gap-5\">\n      <div className=\"flex items-center gap-2\">\n        <ProgressCircle value={72} className=\"size-5 text-primary\" />\n        <span className=\"text-sm\">72% uploaded</span>\n      </div>\n      <div className=\"flex items-center gap-2\">\n        <ProgressCircle\n          isIndeterminate\n          className=\"size-5 text-muted-foreground\"\n        />\n        <span className=\"text-sm\">Processing</span>\n      </div>\n      <div className=\"flex items-center gap-2 text-success\">\n        <CheckIcon className=\"size-5\" />\n        <span className=\"text-sm\">Complete</span>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
