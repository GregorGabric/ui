{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "input-preskok-demo",
  "registryDependencies": [
    "https://ui-three-mu.vercel.app/r/input.json",
    "https://ui-three-mu.vercel.app/r/button.json",
    "https://ui-three-mu.vercel.app/r/loader.json"
  ],
  "files": [
    {
      "path": "registry/preskok/examples/input-preskok-demo.tsx",
      "content": "\"use client\"\n\nimport { MailIcon, SearchIcon } from \"lucide-react\"\n\nimport {\n  Input,\n  InputGroup,\n  InputGroupAddon,\n  InputGroupButton,\n  InputGroupInput,\n  InputGroupText,\n} from \"@/components/ui/preskok-ui/input\"\nimport { Loader } from \"@/components/ui/preskok-ui/loader\"\n\nexport default function InputPreskokDemo() {\n  return (\n    <div className=\"space-y-4\">\n      <div>\n        <label className=\"mb-2 block text-sm font-medium\">Basic Input</label>\n        <Input placeholder=\"Enter your email\" />\n      </div>\n\n      <div>\n        <label className=\"mb-2 block text-sm font-medium\">\n          Input with Icon\n        </label>\n        <InputGroup>\n          <InputGroupAddon>\n            <MailIcon />\n          </InputGroupAddon>\n          <InputGroupInput placeholder=\"you@example.com\" />\n        </InputGroup>\n      </div>\n\n      <div>\n        <label className=\"mb-2 block text-sm font-medium\">\n          Input with Loading State\n        </label>\n        <InputGroup>\n          <InputGroupInput placeholder=\"Searching...\" />\n          <InputGroupAddon align=\"inline-end\">\n            <Loader variant=\"spin\" />\n          </InputGroupAddon>\n        </InputGroup>\n      </div>\n\n      <div>\n        <label className=\"mb-2 block text-sm font-medium\">\n          Input with Button\n        </label>\n        <InputGroup>\n          <InputGroupInput placeholder=\"Enter search term\" />\n          <InputGroupAddon align=\"inline-end\">\n            <InputGroupButton\n              intent=\"primary\"\n              size=\"icon-sm\"\n              aria-label=\"Search\"\n            >\n              <SearchIcon />\n            </InputGroupButton>\n          </InputGroupAddon>\n        </InputGroup>\n      </div>\n\n      <div>\n        <label className=\"mb-2 block text-sm font-medium\">\n          Input with Text Prefix\n        </label>\n        <InputGroup>\n          <InputGroupAddon>\n            <InputGroupText>https://</InputGroupText>\n          </InputGroupAddon>\n          <InputGroupInput />\n          <InputGroupAddon align=\"inline-end\">\n            <InputGroupText>.com</InputGroupText>\n          </InputGroupAddon>\n        </InputGroup>\n      </div>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}