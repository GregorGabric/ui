{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "carousel-preskok-demo",
  "registryDependencies": [
    "https://ui-three-mu.vercel.app/r/carousel.json",
    "https://ui-three-mu.vercel.app/r/card.json"
  ],
  "files": [
    {
      "path": "registry/preskok/examples/carousel-preskok-demo.tsx",
      "content": "\"use client\"\n\nimport { Card, CardContent } from \"@/components/ui/preskok-ui/card\"\nimport {\n  Carousel,\n  CarouselButton,\n  CarouselContent,\n  CarouselHandler,\n  CarouselItem,\n} from \"@/components/ui/preskok-ui/carousel\"\n\nexport default function CarouselPreskokDemo() {\n  const releases = [\n    { name: \"Audit log\", detail: \"Workspace events with actor metadata\" },\n    { name: \"Approvals\", detail: \"Policy gates for sensitive exports\" },\n    { name: \"Usage caps\", detail: \"Per-team budgets and overage alerts\" },\n  ]\n\n  return (\n    <div className=\"grid w-full max-w-2xl gap-8 md:grid-cols-[1fr_16rem]\">\n      <Carousel className=\"w-full\" opts={{ align: \"start\", loop: true }}>\n        <CarouselContent>\n          {releases.map((release) => (\n            <CarouselItem\n              key={release.name}\n              className=\"basis-full sm:basis-1/2\"\n            >\n              <div className=\"p-1\">\n                <Card>\n                  <CardContent className=\"grid aspect-[4/3] content-center gap-2 p-6\">\n                    <span className=\"text-lg font-semibold\">\n                      {release.name}\n                    </span>\n                    <span className=\"text-muted-foreground text-sm\">\n                      {release.detail}\n                    </span>\n                  </CardContent>\n                </Card>\n              </div>\n            </CarouselItem>\n          ))}\n        </CarouselContent>\n        <CarouselHandler className=\"justify-between\">\n          <CarouselButton segment=\"previous\" />\n          <CarouselButton segment=\"next\" />\n        </CarouselHandler>\n      </Carousel>\n\n      <Carousel orientation=\"vertical\" className=\"h-64\">\n        <CarouselContent className=\"h-52\">\n          {releases.map((release) => (\n            <CarouselItem key={release.name}>\n              <Card>\n                <CardContent className=\"grid h-48 content-center gap-2 p-5\">\n                  <span className=\"font-medium\">{release.name}</span>\n                  <span className=\"text-muted-foreground text-sm\">\n                    {release.detail}\n                  </span>\n                </CardContent>\n              </Card>\n            </CarouselItem>\n          ))}\n        </CarouselContent>\n        <CarouselHandler>\n          <CarouselButton segment=\"previous\" />\n          <CarouselButton segment=\"next\" />\n        </CarouselHandler>\n      </Carousel>\n    </div>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}