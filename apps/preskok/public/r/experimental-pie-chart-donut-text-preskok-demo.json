{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "experimental-pie-chart-donut-text-preskok-demo",
  "registryDependencies": [
    "https://ui-three-mu.vercel.app/r/experimental-pie-chart.json",
    "https://ui-three-mu.vercel.app/r/card.json"
  ],
  "files": [
    {
      "path": "registry/preskok/examples/experimental-pie-chart-donut-text-preskok-demo.tsx",
      "content": "\"use client\"\n\nimport { TrendingUp } from \"lucide-react\"\n\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardFooter,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/preskok-ui/card\"\nimport { ExperimentalPieChart } from \"@/components/ui/preskok-ui/experimental-pie-chart\"\n\nconst chartData = [\n  { browser: \"chrome\", visitors: 275 },\n  { browser: \"safari\", visitors: 200 },\n  { browser: \"firefox\", visitors: 187 },\n  { browser: \"edge\", visitors: 173 },\n  { browser: \"other\", visitors: 90 },\n]\n\nexport default function ExperimentalPieChartDonutTextPreskokDemo() {\n  return (\n    <Card className=\"w-full max-w-md\">\n      <CardHeader className=\"items-center pb-0 text-center\">\n        <CardTitle>Pie Chart - Donut with Text</CardTitle>\n        <CardDescription>January - June 2024</CardDescription>\n      </CardHeader>\n      <CardContent>\n        <ExperimentalPieChart\n          ariaLabel=\"Pie Chart - Donut with Text\"\n          className=\"mx-auto\"\n          data={chartData}\n          dataKey=\"visitors\"\n          nameKey=\"browser\"\n          size={{ height: 250 }}\n          variant=\"donut\"\n          centerLabel=\"Visitors\"\n          centerValue=\"1,125\"\n          pieProps={{ stroke: \"var(--background)\", strokeWidth: 2 }}\n          legend={false}\n          config={{\n            chrome: { label: \"Chrome\", color: \"var(--chart-1)\" },\n            safari: { label: \"Safari\", color: \"var(--chart-2)\" },\n            firefox: { label: \"Firefox\", color: \"var(--chart-3)\" },\n            edge: { label: \"Edge\", color: \"var(--chart-4)\" },\n            other: { label: \"Other\", color: \"var(--chart-5)\" },\n          }}\n        />\n      </CardContent>\n      <CardFooter className=\"flex-col items-center gap-2 text-sm\">\n        <div className=\"flex items-center gap-2 leading-none font-medium\">\n          Trending up by 5.2% this month\n          <TrendingUp aria-hidden className=\"size-4\" />\n        </div>\n        <div className=\"leading-none text-muted-foreground\">\n          Showing total visitors for the last 6 months\n        </div>\n      </CardFooter>\n    </Card>\n  )\n}\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}